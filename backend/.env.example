# OpenAI API key for LLM and embeddings
# Required for chat completions and ChromaDB product embeddings.
# Get from https://platform.openai.com/api-keys
OPENAI_API_KEY=

# LLM model to use for the agent
# Default: gpt-4o
# Options: gpt-4o, gpt-4-turbo, gpt-4o-mini, etc.
LLM_MODEL=gpt-4o

# Embedding model for ChromaDB (RAG)
# Default: text-embedding-3-small
# Options: text-embedding-3-small, text-embedding-3-large, text-embedding-ada-002
EMBEDDING_MODEL=text-embedding-3-small

# Optional: LangSmith tracing/evals.
# App chat works without these. Set tracing to true only when you want traces in LangSmith.
LANGCHAIN_TRACING_V2=false
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# Required only when LANGCHAIN_TRACING_V2=true or when running eval uploads.
# Get API key from https://smith.langchain.com → Settings → API Keys
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ecommerce-ai-assistant
